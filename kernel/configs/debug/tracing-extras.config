# Help: The tracers, dynamic events and tracing tests debug/tracing leaves out
#
# Layered on debug/tracing.config: the function graph tracer and
# fprobes, the latency tracers (irqsoff, preemptoff, wakeup, hwlat,
# osnoise and timerlat), the MMIO tracer, snapshots, event probes,
# histogram triggers and synthetic events, user events, event
# injection, boot-time tracing and recursion recording, and the
# benchmarks and test modules of kernel/trace/.
#
# Three build what they test into the whole kernel: FTRACE_STARTUP_TEST
# runs every tracer's selftest at boot, PROFILE_ANNOTATED_BRANCHES
# counts each likely() and unlikely() taken, and KGDB_KDB carries kdb,
# whose ftdump command prints the trace buffer. Keep them out of a
# kernel that is timed.
#
# Prerequisites inlined per the self-containment rule:
# - debug/tracing.config's FTRACE, FUNCTION_TRACER, DYNAMIC_FTRACE and
#   KPROBE_EVENTS, on PERF_EVENTS and KPROBES.
# - PREEMPT for PREEMPT_TRACER, PM for the runtime PM events, KGDB for
#   KGDB_KDB and KUNIT for EVENT_TRACING_TEST.
#
# The test modules are loaded on demand; no builtin/ counterpart
# needed.
# See: kernel/trace/Kconfig
# See: https://docs.kernel.org/trace/index.html

#
# Inlined prerequisites
#
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PREEMPT=y
CONFIG_PM=y
CONFIG_KGDB=y
CONFIG_KUNIT=y

#
# Tracers
#
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_FPROBE=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_HWLAT_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_MMIOTRACE=y
CONFIG_TRACER_SNAPSHOT=y

#
# Dynamic events and triggers
#
CONFIG_FPROBE_EVENTS=y
CONFIG_EPROBE_EVENTS=y
CONFIG_HIST_TRIGGERS=y
CONFIG_SYNTH_EVENTS=y
CONFIG_USER_EVENTS=y
CONFIG_TRACE_EVENT_INJECT=y
CONFIG_BOOTTIME_TRACING=y
CONFIG_FTRACE_RECORD_RECURSION=y

#
# Benchmarks and tests
#
CONFIG_TRACEPOINT_BENCHMARK=y
CONFIG_RING_BUFFER_BENCHMARK=m
CONFIG_PREEMPTIRQ_DELAY_TEST=m
CONFIG_SYNTH_EVENT_GEN_TEST=m
CONFIG_KPROBE_EVENT_GEN_TEST=m
CONFIG_TRACE_REMOTE_TEST=m
CONFIG_EVENT_TRACING_TEST=m
CONFIG_FTRACE_STARTUP_TEST=y
CONFIG_PROFILE_ANNOTATED_BRANCHES=y
CONFIG_KGDB_KDB=y
