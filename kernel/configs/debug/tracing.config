# Help: Dynamic tracing: the function tracer, kprobes and uprobes
#
# KPROBE_EVENTS and UPROBE_EVENTS select KPROBES' and UPROBES' code,
# each architecture's arch/*/kernel/probes/ included. Both sit under the
# FTRACE menu and need PERF_EVENTS; DYNAMIC_FTRACE defaults to y behind a
# prompt, which allnoconfig answers n. security/ebpf.config inlines all of
# this for BPF.
# See: kernel/trace/Kconfig
# See: https://docs.kernel.org/trace/index.html
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
