# Help: Lock dependency checking (lockdep) with PROVE_LOCKING
#
# PROVE_LOCKING selects LOCKDEP and the spinlock, mutex and rwsem debug
# options, and reports a lock ordering that can deadlock the first time
# the kernel takes it, before it ever deadlocks. It makes every lock
# operation slower, so it suits a debug or check build, not a benchmark.
#
# Relies on DEBUG_KERNEL from core/core.config. Every symbol is bool. No
# builtin/ counterpart needed.
# See: lib/Kconfig.debug
# See: https://docs.kernel.org/locking/lockdep-design.html
CONFIG_PROVE_LOCKING=y
