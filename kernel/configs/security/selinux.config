# Help: SELinux alone, booting permissive
#
# security/lsm-modules.config builds every major LSM, lockdown with
# module signing among them; this fragment builds SELinux only, the
# first major LSM by default once it is set. SECURITY_SELINUX_DEVELOP
# boots it permissive unless enforcing=1 is on the command line, so a
# system with no policy, or with one that does not know its files,
# still runs.
#
# Prerequisites inlined per the self-containment rule:
# - SECURITY_NETWORK, AUDIT, NET and INET gate SECURITY_SELINUX.
#   AUDIT=y overrides core/systemd.config's AUDIT=n.
# See: security/selinux/Kconfig
# See: https://docs.kernel.org/admin-guide/LSM/SELinux.html

#
# Inlined prerequisites
#
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
CONFIG_NET=y
CONFIG_INET=y

#
# SELinux
#
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
