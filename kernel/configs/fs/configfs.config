# Help: configfs with its sample
#
# CONFIGFS_FS, =m in core/core.config, and samples/configfs, which
# Kconfig builds only as a module.
#
# Layer builtin/fs/configfs.config to build configfs in (=y); the
# sample stays a module.
# See: fs/configfs/Kconfig
# See: samples/Kconfig
CONFIG_CONFIGFS_FS=m
CONFIG_SAMPLES=y
CONFIG_SAMPLE_CONFIGFS=m
