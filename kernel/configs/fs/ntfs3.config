# Help: NTFS3 filesystem
#
# NTFS3_FS builds fs/ntfs3/, the read-write NTFS driver; NTFS_FS is a
# compatibility wrapper that selects it (docs/design-decisions.md,
# "Excluded configs"). NTFS3_LZX_XPRESS reads files Windows compressed
# with LZX or Xpress.
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
