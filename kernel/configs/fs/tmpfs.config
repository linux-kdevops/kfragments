# Help: tmpfs with quotas and memfd
#
# TMPFS with POSIX ACLs and extended attributes, as core/systemd.config
# sets it, plus 64-bit inode numbers and quotas (TMPFS_QUOTA), and
# memfd_create(), which TMPFS selects.
#
# Every symbol is bool. No builtin/ counterpart needed.
# See: fs/Kconfig
# See: https://docs.kernel.org/filesystems/tmpfs.html
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_INODE64=y
CONFIG_TMPFS_QUOTA=y
CONFIG_MEMFD_CREATE=y
