# Help: binfmt_misc handlers written in BPF
#
# BINFMT_MISC_BPF lets a BPF struct_ops program match a binary and
# name its interpreter, where a binfmt_misc entry matches a fixed
# magic. It needs binfmt_misc built in and BPF with BTF, so the kernel
# carries DWARF debug info, from which pahole makes the BTF.
#
# Prerequisites inlined per the self-containment rule:
# - BINFMT_MISC=y: the BPF handlers hook the built-in binfmt_misc.
# - BPF_SYSCALL + BPF_JIT + DEBUG_INFO_BTF, on DEBUG_INFO with the
#   toolchain's DWARF version.
#
# Every symbol is bool. No builtin/ counterpart needed.
# See: fs/Kconfig.binfmt

#
# Inlined prerequisites
#
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BINFMT_MISC=y

#
# BPF handlers
#
CONFIG_BINFMT_MISC_BPF=y
