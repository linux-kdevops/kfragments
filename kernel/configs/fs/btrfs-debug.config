# Help: btrfs debugging: assertions, reference verification and sanity tests
#
# BTRFS_DEBUG adds btrfs's debug checks, the extent reference verifier
# among them; BTRFS_ASSERT turns its ASSERT()s on, and
# BTRFS_FS_RUN_SANITY_TESTS runs the unit tests of fs/btrfs/tests/
# each time the module loads. All slow btrfs down.
#
# Prerequisites inlined per the self-containment rule:
# - BTRFS_FS.
#
# Every symbol is bool. No builtin/ counterpart needed.
# See: fs/btrfs/Kconfig
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_DEBUG=y
CONFIG_BTRFS_ASSERT=y
CONFIG_BTRFS_FS_RUN_SANITY_TESTS=y
