# Help: Intel i915 graphics driver
#
# DRM_I915 builds drivers/gpu/drm/i915/ on x86 with PCI; on another
# architecture Kconfig drops the request. DRM is inlined as =m, so a
# fragment that needs DRM=y, as rust/drm.config, goes after this one.
# See: drivers/gpu/drm/i915/Kconfig
CONFIG_DRM=m
CONFIG_DRM_I915=m
