# Help: Built-in overrides for the device mapper targets and features dm-targets leaves out
#
# With dm-mod built in, the dm-mod.create= parameter (DM_INIT) sets up
# devices before user space starts, and LoadPin, when it enforces,
# trusts kernel files read from a dm-verity device it is told of
# (SECURITY_LOADPIN_VERITY). LoadPin enforces only when booted with
# loadpin.enforce=1.
# See: security/loadpin/Kconfig
CONFIG_BLK_DEV_DM=y
CONFIG_DM_MIRROR=y
CONFIG_DM_MULTIPATH=y
CONFIG_DM_VERITY=y
CONFIG_DM_ZONED=y
CONFIG_DM_EBS=y
CONFIG_DM_SWITCH=y
CONFIG_DM_UNSTRIPED=y
CONFIG_DM_INLINECRYPT=y
CONFIG_DM_LOG_USERSPACE=y
CONFIG_DM_MULTIPATH_IOA=y
CONFIG_DM_INIT=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LOADPIN=y
CONFIG_SECURITY_LOADPIN_VERITY=y
