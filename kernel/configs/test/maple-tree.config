# Help: Maple Tree unit test support
#
# lib/test_maple_tree.c, loaded on demand. test/selftests.config builds
# it among the other TEST_* modules.
#
# RUNTIME_TESTING_MENU gates TEST_MAPLE_TREE. Tristate, loaded on
# demand; no builtin/ counterpart needed.
# See: lib/Kconfig.debug
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_TEST_MAPLE_TREE=m
