# Help: The sysctl test driver
#
# lib/test_sysctl.c, the module the sysctl selftests drive, loaded on
# demand. test/selftests.config builds it among the other TEST_*
# modules.
#
# RUNTIME_TESTING_MENU gates TEST_SYSCTL, which depends on SYSCTL from
# the base. Tristate, loaded on demand; no builtin/ counterpart needed.
# See: lib/Kconfig.debug
CONFIG_RUNTIME_TESTING_MENU=y
CONFIG_TEST_SYSCTL=m
