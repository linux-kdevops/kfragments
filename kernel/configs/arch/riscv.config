# Help: RISC-V-specific QEMU virt machine configs
#
# The riscv virt machine runs under the SBI firmware, with a 16550 UART for
# serial, a generic PCIe host bridge for virtio-pci, and virtio-mmio slots.
# allnoconfig answers n to what RISC-V defaults to y behind a prompt, the
# MMU and the FPU among them, so they are written here.
# See: arch/riscv/Kconfig, arch/riscv/Kconfig.socs

# Paged memory, and the FPU that userspace's floating point needs
CONFIG_MMU=y
CONFIG_FPU=y

# Without NUMA the memory model defaults to FLATMEM, under which memory
# hotplug, and with it ZONE_DEVICE and DAX, cannot be built
# (mm/Kconfig, arch/riscv/Kconfig)
CONFIG_SPARSEMEM_MANUAL=y
CONFIG_SPARSEMEM_VMEMMAP=y

# QEMU virt machine (arch/riscv/Kconfig.socs)
CONFIG_ARCH_VIRT=y

# Serial console (console=ttyS0 on riscv QEMU virt)
# The UART is found through the device tree. SERIAL_8250_CONSOLE depends
# on SERIAL_8250=y (not =m), and its device tree probe must be built in
# too for the console to come up; earlycon=sbi prints before it.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y

# PCIe host bridge (ECAM) for virtio-pci, and memory-mapped virtio
CONFIG_PCI_HOST_GENERIC=m
CONFIG_VIRTIO_MMIO=m
