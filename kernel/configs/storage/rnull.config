# Help: Rust null block driver (rnull)
#
# Configured only through configfs, under /sys/kernel/config/rnull/<name>/;
# the group name becomes the disk name.
#
# See: drivers/block/rnull/Kconfig

#
# Inlined prerequisites
#
CONFIG_RANDSTRUCT_NONE=y
CONFIG_RUST=y
CONFIG_CONFIGFS_FS=m

#
# Rust null block driver
#
CONFIG_BLK_DEV_RUST_NULL=m
