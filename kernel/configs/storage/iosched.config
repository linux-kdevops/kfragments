# Help: The Kyber and BFQ multiqueue I/O schedulers
#
# mq-deadline is built by default; Kyber and BFQ are not. BFQ keeps an
# I/O context per process and queue (BLK_ICQ, which it selects), so with
# it the block layer's io-context code is built too.
#
# builtin/storage/iosched.config builds both into the kernel.
# See: block/Kconfig.iosched
# See: https://docs.kernel.org/block/bfq-iosched.html
CONFIG_MQ_IOSCHED_KYBER=m
CONFIG_IOSCHED_BFQ=m
