# Help: The NVMe PCI endpoint function target
#
# nvmet-pci-epf presents an NVMe target's namespaces to a PCIe host as
# an NVMe controller, through the PCI endpoint controller of the
# machine it runs on. It builds without one, which a guest lacks.
#
# Prerequisites inlined per the self-containment rule:
# - NVME_TARGET, and BLK_DEV_NVME, whose select builds NVME_CORE,
#   which NVME_TARGET_PCI_EPF needs at least as built in as itself.
# - PCI_ENDPOINT, the endpoint framework.
#
# Tristate, loaded on demand; no builtin/ counterpart needed.
# See: drivers/nvme/target/Kconfig
# See: https://docs.kernel.org/nvme/nvme-pci-endpoint-target.html
CONFIG_BLK_DEV_NVME=m
CONFIG_NVME_TARGET=m
CONFIG_PCI_ENDPOINT=y
CONFIG_NVME_TARGET_PCI_EPF=m
