# Help: iSCSI initiator over TCP
#
# open-iscsi's iscsid logs in to iSCSI targets through ISCSI_TCP, which
# selects the iSCSI transport class (SCSI_ISCSI_ATTRS).
#
# Prerequisites inlined per the self-containment rule:
# - SCSI_LOWLEVEL and INET gate ISCSI_TCP.
# See: drivers/scsi/Kconfig
# See: https://www.open-iscsi.com/
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_ISCSI_TCP=m
