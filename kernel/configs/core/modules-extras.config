# Help: The module loader's optional parts: decompression, livepatch, kdb
#
# In-kernel module decompression (Zstandard), the duplicate autoload
# debugging debug/modules-debug.config leaves off, livepatch's module
# notifier and kdb's module listing. MODULE_COMPRESS_ALL stays off, so
# modules_install writes the modules uncompressed as before.
#
# Prerequisites inlined per the self-containment rule:
# - FTRACE + FUNCTION_TRACER + DYNAMIC_FTRACE give the ftrace with
#   arguments LIVEPATCH patches through, and KALLSYMS_ALL the symbols
#   it resolves.
# - DEBUG_KERNEL gates KGDB and KALLSYMS_ALL.
# - MODULE_DEBUG, on DEBUG_FS, holds MODULE_DEBUG_AUTOLOAD_DUPS.
#
# Every symbol is bool. No builtin/ counterpart needed.
# See: kernel/module/Kconfig
# See: kernel/livepatch/Kconfig
# See: https://docs.kernel.org/livepatch/livepatch.html

#
# Inlined prerequisites
#
CONFIG_DEBUG_KERNEL=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_FS=y
CONFIG_MODULE_DEBUG=y

#
# Module loader
#
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=n
CONFIG_MODULE_DECOMPRESS=y
CONFIG_MODULE_DEBUG_AUTOLOAD_DUPS=y
CONFIG_LIVEPATCH=y
CONFIG_KGDB=y
CONFIG_KGDB_KDB=y
