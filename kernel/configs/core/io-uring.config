# Help: io_uring with its mock files
#
# IO_URING is on in core/core.config; this adds the mock files
# (IO_URING_MOCK_FILE), which io_uring's tests open in place of a real
# file or socket. The prompt needs EXPERT, also from core.config. The
# other optional parts follow the rest of the configuration: zero-copy
# receive with INET, the dma-buf registration with DMA_SHARED_BUFFER
# (mem/dma-buf.config), and the BPF ops with BTF
# (security/ebpf.config).
#
# Layer builtin/core/io-uring.config to build the mock files in (=y).
# See: init/Kconfig
# See: io_uring/Kconfig
CONFIG_EXPERT=y
CONFIG_IO_URING=y
CONFIG_IO_URING_MOCK_FILE=m
