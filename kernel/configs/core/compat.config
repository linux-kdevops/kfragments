# Help: 32-bit binaries on a 64-bit kernel
#
# The compat syscalls, ioctls and ELF loader that run 32-bit programs:
# IA32_EMULATION on x86_64, which turns COMPAT on, and COMPAT itself on
# arm64 (AArch32) and riscv (RV32). Each arch ignores the other's
# symbol. Filesystems and drivers build their compat ioctl handlers
# under COMPAT.
#
# Every symbol is bool. No builtin/ counterpart needed.
# See: arch/x86/Kconfig
# See: arch/arm64/Kconfig
# See: arch/riscv/Kconfig
CONFIG_IA32_EMULATION=y
CONFIG_COMPAT=y
