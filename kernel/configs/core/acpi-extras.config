# Help: ACPI platform subsystem (x86/arm64 firmware glue)
#
# APEI (error injection/reporting), HMAT (heterogeneous memory
# topology), CPU/memory/IOAPIC hotplug, NUMA, DOCK/CONTAINER
# hotplug, table upgrade, sleep/S3, processor idle and C-state
# drivers, NFIT (NVDIMM firmware interface), BGRT, extended error
# log, HED, PRMT, PCC, SPCR, and ACPI revision override.
#
# Prerequisites inlined:
# - NUMA + X86_64_ACPI_NUMA gate ACPI_NUMA on x86 (x86 selects
#   ACPI_NUMA through X86_64_ACPI_NUMA; arm64 uses
#   "def_bool NUMA && !X86").
# - MEMORY_HOTPLUG gates ACPI_HOTPLUG_MEMORY.
# - SUSPEND + HIBERNATION gate ACPI_SLEEP; SWAP gates HIBERNATION.
# - X86_MCE gates MEMORY_FAILURE on x86, which gates
#   ACPI_APEI_MEMORY_FAILURE.
# - PCIEPORTBUS + PCIEAER gate ACPI_APEI_PCIEAER.
# - I2C gates ACPI_I2C_OPREGION.
# - MAILBOX + PCC gate ACPI_PCC.
# - EFI gates ACPI_BGRT and ACPI_PRMT.
# - X86_MCE + RAS + EDAC gate ACPI_EXTLOG.
#
# ACPI_BUTTON is left unset: ACPI_TINY_POWER_BUTTON=y in
# core/acpi-poweroff.config depends on !ACPI_BUTTON, so
# ACPI_BUTTON=m would cap it at m.
#
# Every symbol is bool except ACPI_NFIT, ACPI_EXTLOG and EDAC (=m).
# No builtin/ counterpart needed.
# See: drivers/acpi/Kconfig
# See: arch/x86/Kconfig (X86_64_ACPI_NUMA)
# See: https://docs.kernel.org/admin-guide/acpi/index.html

#
# Inlined prerequisites
#
CONFIG_NUMA=y
CONFIG_X86_64_ACPI_NUMA=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_SUSPEND=y
CONFIG_SWAP=y
CONFIG_HIBERNATION=y
CONFIG_X86_MCE=y
CONFIG_MEMORY_FAILURE=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_I2C=y
CONFIG_MAILBOX=y
CONFIG_PCC=y
CONFIG_EFI=y
CONFIG_RAS=y
CONFIG_EDAC=m

CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
CONFIG_ACPI_APEI_MEMORY_FAILURE=y
CONFIG_ACPI_APEI_PCIEAER=y
CONFIG_ACPI_BGRT=y
CONFIG_ACPI_CONTAINER=y
CONFIG_ACPI_DOCK=y
CONFIG_ACPI_EXTLOG=m
CONFIG_ACPI_HED=y
CONFIG_ACPI_HMAT=y
CONFIG_ACPI_HOTPLUG_CPU=y
CONFIG_ACPI_HOTPLUG_IOAPIC=y
CONFIG_ACPI_HOTPLUG_MEMORY=y
CONFIG_ACPI_I2C_OPREGION=y
CONFIG_ACPI_NFIT=m
CONFIG_ACPI_NUMA=y
CONFIG_ACPI_PCC=y
CONFIG_ACPI_PRMT=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_PROCESSOR_CSTATE=y
CONFIG_ACPI_PROCESSOR_IDLE=y
CONFIG_ACPI_REV_OVERRIDE_POSSIBLE=y
CONFIG_ACPI_SLEEP=y
CONFIG_ACPI_SPCR_TABLE=y
CONFIG_ACPI_TABLE_UPGRADE=y
