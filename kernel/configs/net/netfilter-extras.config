# Help: The netfilter tables, matches, helpers and sets the others leave out
#
# Layered on net/netfilter-xtables.config, net/nftables.config and
# net/netfilter-nat.config: ebtables, with bridge connection tracking
# and nftables' bridge meta expression, arptables, the security tables,
# SYNPROXY and the IPv6 matches and targets the others lack, every ipset
# type, the Amanda and SNMP connection tracking helpers, user-space
# helpers and timeouts over netlink, the hook dump, the mixed IPv4 and
# IPv6 flow table with its statistics, and the CONNSECMARK, LED and
# NETMAP targets. NF_CONNTRACK_OVS and NF_NAT_OVS, the hooks Open
# vSwitch and tc's ct action share, have no prompt; tc's ct action
# selects them here.
#
# Prerequisites inlined per the self-containment rule:
# - NETFILTER_ADVANCED, x_tables with its legacy tables, connection
#   tracking, NAT, nf_tables and its bridge family, and the bridge.
# - NETFILTER_INGRESS and NF_FLOW_TABLE for the flow table.
# - NF_CT_NETLINK and NETFILTER_NETLINK_QUEUE, with conntrack in queued
#   packets, for user-space helpers, and NF_CONNTRACK_TIMEOUT.
# - SECURITY and NETWORK_SECMARK, with NF_CONNTRACK_SECMARK, for the
#   security tables and CONNSECMARK.
# - LEDS_CLASS and LEDS_TRIGGERS for the LED target.
# - NET_SCHED and NET_CLS_ACT for tc's ct action.
#
# Every module is loaded on demand; no builtin/ counterpart needed.
# See: net/netfilter/Kconfig
# See: net/bridge/netfilter/Kconfig
# See: net/ipv4/netfilter/Kconfig
# See: net/ipv6/netfilter/Kconfig
# See: net/netfilter/ipset/Kconfig

#
# Inlined prerequisites
#
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_BRIDGE=m
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_NAT=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_NETLINK_GLUE_CT=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_NF_FLOW_TABLE=m
CONFIG_SECURITY=y
CONFIG_NETWORK_SECMARK=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=m
CONFIG_LEDS_TRIGGERS=y
CONFIG_IP_SET=m
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y

#
# ebtables and bridge connection tracking
#
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_BRIDGE_NF_EBTABLES_LEGACY=m
CONFIG_BRIDGE_EBT_BROUTE=m
CONFIG_BRIDGE_EBT_T_FILTER=m
CONFIG_BRIDGE_EBT_T_NAT=m
CONFIG_BRIDGE_EBT_802_3=m
CONFIG_BRIDGE_EBT_AMONG=m
CONFIG_BRIDGE_EBT_ARP=m
CONFIG_BRIDGE_EBT_IP=m
CONFIG_BRIDGE_EBT_IP6=m
CONFIG_BRIDGE_EBT_LIMIT=m
CONFIG_BRIDGE_EBT_MARK=m
CONFIG_BRIDGE_EBT_PKTTYPE=m
CONFIG_BRIDGE_EBT_STP=m
CONFIG_BRIDGE_EBT_VLAN=m
CONFIG_BRIDGE_EBT_ARPREPLY=m
CONFIG_BRIDGE_EBT_DNAT=m
CONFIG_BRIDGE_EBT_MARK_T=m
CONFIG_BRIDGE_EBT_REDIRECT=m
CONFIG_BRIDGE_EBT_SNAT=m
CONFIG_BRIDGE_EBT_LOG=m
CONFIG_BRIDGE_EBT_NFLOG=m
CONFIG_NF_CONNTRACK_BRIDGE=m
CONFIG_NFT_BRIDGE_META=m

#
# arptables
#
CONFIG_IP_NF_ARPTABLES=m
CONFIG_IP_NF_ARPFILTER=m
CONFIG_IP_NF_ARP_MANGLE=m

#
# iptables and ip6tables
#
CONFIG_IP_NF_SECURITY=m
CONFIG_IP_NF_TARGET_SYNPROXY=m
CONFIG_IP6_NF_SECURITY=m
CONFIG_IP6_NF_TARGET_SYNPROXY=m
CONFIG_IP6_NF_TARGET_NPT=m
CONFIG_IP6_NF_MATCH_FRAG=m
CONFIG_IP6_NF_MATCH_MH=m
CONFIG_IP6_NF_MATCH_OPTS=m
CONFIG_IP6_NF_MATCH_SRH=m
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=m
CONFIG_NETFILTER_XT_TARGET_LED=m
CONFIG_NETFILTER_XT_TARGET_NETMAP=m

#
# ipset types
#
CONFIG_IP_SET_BITMAP_IP=m
CONFIG_IP_SET_BITMAP_IPMAC=m
CONFIG_IP_SET_BITMAP_PORT=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_IPMARK=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_IPPORTIP=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_IPMAC=m
CONFIG_IP_SET_HASH_MAC=m
CONFIG_IP_SET_HASH_NETPORTNET=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_NETNET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_NETIFACE=m
CONFIG_IP_SET_LIST_SET=m

#
# Connection tracking helpers, netlink and flow tables
#
CONFIG_NF_CONNTRACK_AMANDA=m
CONFIG_NF_CONNTRACK_SNMP=m
CONFIG_NF_NAT_SNMP_BASIC=m
CONFIG_NF_CT_NETLINK_HELPER=m
CONFIG_NF_CT_NETLINK_TIMEOUT=m
CONFIG_NETFILTER_NETLINK_HOOK=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NF_FLOW_TABLE_PROCFS=y
CONFIG_NET_ACT_CT=m
