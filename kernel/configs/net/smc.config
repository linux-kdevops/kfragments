# Help: SMC, the Shared Memory Communications socket family
#
# SMC depends on INFINIBAND, for SMC-R over RDMA, and on DIBS, for SMC-D
# over shared memory, so both are inlined. SMC_DIAG is its socket
# monitoring interface, and SMC_HS_CTRL_BPF lets a BPF program decide
# which connections SMC takes over, on BPF_SYSCALL and BPF_JIT.
# See: net/smc/Kconfig
# See: https://docs.kernel.org/networking/smc-sysctl.html
CONFIG_INFINIBAND=m
CONFIG_DIBS=m
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SMC=m
CONFIG_SMC_DIAG=m
CONFIG_SMC_HS_CTRL_BPF=y
