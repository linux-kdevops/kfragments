# Help: XFRM, the IPsec transform framework
#
# XFRM itself has no prompt: XFRM_USER selects it, through XFRM_ALGO,
# which builds net/xfrm/ and the IPv4 and IPv6 policy code,
# xfrm4_policy.c and xfrm6_policy.c. ESP for both families and XFRM
# interfaces make the framework usable from a guest.
# See: net/xfrm/Kconfig
CONFIG_XFRM_USER=m
CONFIG_INET_ESP=m
CONFIG_INET6_ESP=m
CONFIG_XFRM_INTERFACE=m
