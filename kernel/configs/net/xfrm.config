# Help: XFRM, the IPsec transform framework
#
# XFRM itself has no prompt: XFRM_USER selects it, through XFRM_ALGO,
# which builds net/xfrm/ and the IPv4 and IPv6 policy code,
# xfrm4_policy.c and xfrm6_policy.c. On it, for both families: ESP,
# with its offload and ESP in TCP, AH, IP compression, VTI tunnels and
# XFRM interfaces, then IP-TFS, the deprecated PF_KEY sockets, policy
# migration, sub-policies, statistics in /proc and the 32-bit
# XFRM_USER ABI.
#
# Prerequisites inlined per the self-containment rule:
# - IA32_EMULATION on x86_64 and COMPAT elsewhere, for
#   XFRM_USER_COMPAT (core/compat.config).
# See: net/xfrm/Kconfig
# See: net/ipv4/Kconfig
# See: net/ipv6/Kconfig

#
# Inlined prerequisites
#
CONFIG_IA32_EMULATION=y
CONFIG_COMPAT=y

#
# The framework
#
CONFIG_XFRM_USER=m
CONFIG_XFRM_USER_COMPAT=m
CONFIG_XFRM_INTERFACE=m
CONFIG_XFRM_IPTFS=m
CONFIG_XFRM_SUB_POLICY=y
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y
CONFIG_NET_KEY=m
CONFIG_NET_KEY_MIGRATE=y

#
# IPv4 transforms
#
CONFIG_INET_AH=m
CONFIG_INET_ESP=m
CONFIG_INET_ESP_OFFLOAD=m
CONFIG_INET_ESPINTCP=y
CONFIG_INET_IPCOMP=m
CONFIG_NET_IPVTI=m

#
# IPv6 transforms
#
CONFIG_INET6_AH=m
CONFIG_INET6_ESP=m
CONFIG_INET6_ESP_OFFLOAD=m
CONFIG_INET6_ESPINTCP=y
CONFIG_INET6_IPCOMP=m
CONFIG_IPV6_VTI=m
