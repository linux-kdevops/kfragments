# Help: The IPv4 and IPv6 options the base leaves out
#
# Policy and multipath routing, multicast routing with PIM, the IPIP,
# GRE, SIT, IPv6-in-IPv6 and FOU tunnels, the socket monitoring
# interface for TCP, UDP and raw sockets, every TCP congestion control
# algorithm with CUBIC built in as the default, TCP-MD5 and TCP-AO
# signatures, and for IPv6 the router preference, mobility, identifier
# locator addressing, segment routing, RPL and IOAM routing extensions.
#
# Prerequisites inlined per the self-containment rule:
# - LWTUNNEL, the encapsulation the segment routing, RPL and IOAM
#   extensions use.
# - BPF_SYSCALL for segment routing's BPF actions.
#
# The tunnels and algorithms are modules loaded on demand; no builtin/
# counterpart needed.
# See: net/ipv4/Kconfig
# See: net/ipv6/Kconfig
# See: https://docs.kernel.org/networking/ip-sysctl.html

#
# Inlined prerequisites
#
CONFIG_LWTUNNEL=y
CONFIG_BPF_SYSCALL=y

#
# IPv4 routing and multicast
#
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_ROUTE_VERBOSE=y
CONFIG_IP_MROUTE=y
CONFIG_IP_MROUTE_MULTIPLE_TABLES=y
CONFIG_IP_PIMSM_V1=y
CONFIG_IP_PIMSM_V2=y

#
# IPv4 tunnels
#
CONFIG_NET_IPIP=m
CONFIG_NET_IPGRE_DEMUX=m
CONFIG_NET_IPGRE=m
CONFIG_NET_IPGRE_BROADCAST=y
CONFIG_NET_FOU=m
CONFIG_NET_FOU_IP_TUNNELS=y

#
# Socket monitoring
#
CONFIG_INET_DIAG=m
CONFIG_INET_TCP_DIAG=m
CONFIG_INET_UDP_DIAG=m
CONFIG_INET_RAW_DIAG=m
CONFIG_INET_DIAG_DESTROY=y

#
# TCP
#
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BIC=m
CONFIG_TCP_CONG_WESTWOOD=m
CONFIG_TCP_CONG_HTCP=m
CONFIG_TCP_CONG_HSTCP=m
CONFIG_TCP_CONG_HYBLA=m
CONFIG_TCP_CONG_VEGAS=m
CONFIG_TCP_CONG_NV=m
CONFIG_TCP_CONG_SCALABLE=m
CONFIG_TCP_CONG_LP=m
CONFIG_TCP_CONG_VENO=m
CONFIG_TCP_CONG_YEAH=m
CONFIG_TCP_CONG_ILLINOIS=m
CONFIG_TCP_CONG_DCTCP=m
CONFIG_TCP_CONG_CDG=m
CONFIG_TCP_CONG_BBR=m
CONFIG_TCP_CONG_ROCCET=m
CONFIG_TCP_MD5SIG=y
CONFIG_TCP_AO=y

#
# IPv6
#
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_IPV6_MIP6=m
CONFIG_IPV6_ILA=m
CONFIG_IPV6_SIT=m
CONFIG_IPV6_SIT_6RD=y
CONFIG_IPV6_TUNNEL=m
CONFIG_IPV6_GRE=m
CONFIG_IPV6_FOU=m
CONFIG_IPV6_FOU_TUNNEL=m
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_IPV6_MROUTE=y
CONFIG_IPV6_MROUTE_MULTIPLE_TABLES=y
CONFIG_IPV6_PIMSM_V2=y
CONFIG_IPV6_SEG6_LWTUNNEL=y
CONFIG_IPV6_SEG6_HMAC=y
CONFIG_IPV6_SEG6_BPF=y
CONFIG_IPV6_RPL_LWTUNNEL=y
CONFIG_IPV6_IOAM6_LWTUNNEL=y
