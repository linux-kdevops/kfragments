# Help: IPVS, the IP Virtual Server load balancer
#
# IP_VS builds net/netfilter/ipvs/, ip_vs_ctl.c's sysctl table included,
# for IPv4 and IPv6, with the TCP and UDP schedulers' protocol support,
# round robin and connection tracking. NETFILTER and NF_CONNTRACK are
# inlined; INET is in the base.
# See: net/netfilter/ipvs/Kconfig
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_IP_VS=m
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_NFCT=y
