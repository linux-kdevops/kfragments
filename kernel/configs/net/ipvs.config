# Help: IPVS, the IP Virtual Server load balancer
#
# IP_VS builds net/netfilter/ipvs/, ip_vs_ctl.c's sysctl table included,
# for IPv4 and IPv6, with every protocol it balances (TCP, UDP, SCTP, AH
# and ESP), every scheduler, the FTP helper, the SIP persistence engine
# and connection tracking. NETFILTER, NF_CONNTRACK and NF_NAT, with the
# FTP and SIP connection tracking helpers IP_VS_FTP and IP_VS_PE_SIP
# need, are inlined; INET is in the base.
# See: net/netfilter/ipvs/Kconfig
# See: https://docs.kernel.org/networking/ipvs-sysctl.html

#
# Inlined prerequisites
#
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_SIP=m

#
# IPVS and its protocols
#
CONFIG_IP_VS=m
CONFIG_IP_VS_IPV6=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_PROTO_SCTP=y
CONFIG_IP_VS_PROTO_ESP=y
CONFIG_IP_VS_PROTO_AH=y
CONFIG_IP_VS_NFCT=y

#
# Schedulers
#
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_LC=m
CONFIG_IP_VS_WLC=m
CONFIG_IP_VS_FO=m
CONFIG_IP_VS_OVF=m
CONFIG_IP_VS_LBLC=m
CONFIG_IP_VS_LBLCR=m
CONFIG_IP_VS_DH=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_MH=m
CONFIG_IP_VS_SED=m
CONFIG_IP_VS_NQ=m
CONFIG_IP_VS_TWOS=m

#
# Application helpers
#
CONFIG_IP_VS_FTP=m
CONFIG_IP_VS_PE_SIP=m
