# Help: SCTP, the Stream Control Transmission Protocol
#
# IP_SCTP builds net/sctp/, its sysctl table included, with its socket
# monitoring interface (INET_SCTP_DIAG, built as INET_DIAG is) and the
# object counts SCTP_DBG_OBJCNT reports in /proc; the INET and PROC_FS
# they depend on are in the base.
# See: net/sctp/Kconfig
CONFIG_IP_SCTP=m
CONFIG_INET_DIAG=m
CONFIG_SCTP_DBG_OBJCNT=y
