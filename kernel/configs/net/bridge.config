# Help: Ethernet bridging and 802.1Q VLANs
#
# BRIDGE builds net/bridge/ with IGMP and MLD snooping, VLAN
# filtering, MRP and CFM, and the switchdev offload switches use.
# VLAN_8021Q builds net/8021q/, with GVRP and MVRP, whose GARP and MRP
# protocols it selects from net/802/.
# See: net/bridge/Kconfig
# See: net/8021q/Kconfig
# See: https://docs.kernel.org/networking/bridge.html
CONFIG_BRIDGE=m
CONFIG_BRIDGE_IGMP_SNOOPING=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_BRIDGE_MRP=y
CONFIG_BRIDGE_CFM=y
CONFIG_NET_SWITCHDEV=y
CONFIG_VLAN_8021Q=m
CONFIG_VLAN_8021Q_GVRP=y
CONFIG_VLAN_8021Q_MVRP=y
