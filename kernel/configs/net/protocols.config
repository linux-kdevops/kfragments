# Help: The protocol families of net/ the other fragments leave out
#
# Each family below builds a directory of net/ the base and the other
# net/ fragments do not: ATM with its bridged and PPP encapsulations,
# B.A.T.M.A.N. mesh routing, DSA and its tagging protocols, HSR and PRP,
# IEEE 802.15.4 with 6LoWPAN, L2TP with PPP over it, LAPB and X.25,
# MCTP, MPLS, MPTCP, NC-SI, NFC, Open vSwitch, Phonet, Qualcomm's IPC
# router, RDS, RxRPC, TIPC, KCM, the vsock transports of Hyper-V and
# VMware, and the FDDI and Fibre Channel link layers drivers use.
# net/core's 802.1Q helpers have no prompt; Motorcomm's YT9215 switch
# driver selects them here, with DCB.
#
# Prerequisites inlined per the self-containment rule:
# - PPP for PPP over ATM and over L2TP, and INFINIBAND with IP over
#   InfiniBand for RDS and TIPC over RDMA.
# - SPI for NCI over SPI, RPMSG_VIRTIO and MHI_BUS for the IPC router's
#   channels, and VSOCKETS, with HYPERV and its VMBus and with
#   VMWARE_VMCI, for the vsock transports.
# - SCSI and PCI for NET_FC, LWTUNNEL for MPLS over IP, INET_DIAG for
#   MPTCP's socket monitoring, DCB, FTRACE with FTRACE_SYSCALLS, which
#   selects B.A.T.M.A.N.'s trace events' prerequisites, and KUNIT for
#   the tests.
#
# Every family is a module loaded on demand, but MCTP, MPLS, MPTCP and
# NC-SI, which are bool; no builtin/ counterpart needed.
# See: net/Kconfig
# See: https://docs.kernel.org/networking/index.html

#
# Inlined prerequisites
#
CONFIG_PPP=m
CONFIG_INFINIBAND=m
CONFIG_INFINIBAND_ADDR_TRANS=y
CONFIG_INFINIBAND_IPOIB=m
CONFIG_SPI=y
CONFIG_RPMSG_VIRTIO=m
CONFIG_MHI_BUS=m
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=m
CONFIG_VMWARE_VMCI=m
CONFIG_VSOCKETS=m
CONFIG_SCSI=y
CONFIG_PCI=y
CONFIG_LWTUNNEL=y
CONFIG_INET_DIAG=m
CONFIG_DCB=y
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KUNIT=y

#
# Link layers
#
CONFIG_ATM=m
CONFIG_ATM_BR2684=m
CONFIG_PPPOATM=m
CONFIG_FDDI=m
CONFIG_NET_FC=y
CONFIG_LAPB=m
CONFIG_X25=m

#
# Mesh, switching and redundancy
#
CONFIG_BATMAN_ADV=m
CONFIG_BATMAN_ADV_BATMAN_V=y
CONFIG_BATMAN_ADV_BLA=y
CONFIG_BATMAN_ADV_DAT=y
CONFIG_BATMAN_ADV_MCAST=y
CONFIG_BATMAN_ADV_DEBUG=y
CONFIG_BATMAN_ADV_TRACING=y
CONFIG_NET_DSA=m
CONFIG_NET_DSA_TAG_NONE=m
CONFIG_NET_DSA_TAG_AR9331=m
CONFIG_NET_DSA_TAG_BRCM=m
CONFIG_NET_DSA_TAG_BRCM_LEGACY=m
CONFIG_NET_DSA_TAG_BRCM_LEGACY_FCS=m
CONFIG_NET_DSA_TAG_BRCM_PREPEND=m
CONFIG_NET_DSA_TAG_HELLCREEK=m
CONFIG_NET_DSA_TAG_GSWIP=m
CONFIG_NET_DSA_TAG_DSA=m
CONFIG_NET_DSA_TAG_EDSA=m
CONFIG_NET_DSA_TAG_MTK=m
CONFIG_NET_DSA_TAG_MXL_862XX=m
CONFIG_NET_DSA_TAG_MXL_GSW1XX=m
CONFIG_NET_DSA_TAG_KSZ=m
CONFIG_NET_DSA_TAG_KS8995=m
CONFIG_NET_DSA_TAG_OCELOT=m
CONFIG_NET_DSA_TAG_OCELOT_8021Q=m
CONFIG_NET_DSA_TAG_QCA=m
CONFIG_NET_DSA_TAG_RTL4_A=m
CONFIG_NET_DSA_TAG_RTL8_4=m
CONFIG_NET_DSA_TAG_RZN1_A5PSW=m
CONFIG_NET_DSA_TAG_LAN9303=m
CONFIG_NET_DSA_TAG_SJA1105=m
CONFIG_NET_DSA_TAG_TRAILER=m
CONFIG_NET_DSA_TAG_VSC73XX_8021Q=m
CONFIG_NET_DSA_TAG_XRS700X=m
CONFIG_NET_DSA_TAG_YT921X=m
CONFIG_NET_DSA_TAG_NETC=m
CONFIG_NET_DSA_TAG_MT7628=m
CONFIG_NET_DSA_YT921X=m
CONFIG_HSR=m
CONFIG_PRP_DUP_DISCARD_KUNIT_TEST=m
CONFIG_OPENVSWITCH=m

#
# IEEE 802.15.4 and 6LoWPAN
#
CONFIG_IEEE802154=m
CONFIG_IEEE802154_NL802154_EXPERIMENTAL=y
CONFIG_IEEE802154_SOCKET=m
CONFIG_IEEE802154_6LOWPAN=m
CONFIG_MAC802154=m
CONFIG_6LOWPAN=m
CONFIG_6LOWPAN_DEBUGFS=y
CONFIG_6LOWPAN_NHC=m
CONFIG_6LOWPAN_NHC_DEST=m
CONFIG_6LOWPAN_NHC_FRAGMENT=m
CONFIG_6LOWPAN_NHC_HOP=m
CONFIG_6LOWPAN_NHC_IPV6=m
CONFIG_6LOWPAN_NHC_MOBILITY=m
CONFIG_6LOWPAN_NHC_ROUTING=m
CONFIG_6LOWPAN_NHC_UDP=m
CONFIG_6LOWPAN_GHC_EXT_HDR_HOP=m
CONFIG_6LOWPAN_GHC_UDP=m
CONFIG_6LOWPAN_GHC_ICMPV6=m
CONFIG_6LOWPAN_GHC_EXT_HDR_DEST=m
CONFIG_6LOWPAN_GHC_EXT_HDR_FRAG=m
CONFIG_6LOWPAN_GHC_EXT_HDR_ROUTE=m

#
# Tunnels and label switching
#
CONFIG_L2TP=m
CONFIG_L2TP_DEBUGFS=m
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=m
CONFIG_L2TP_ETH=m
CONFIG_PPPOL2TP=m
CONFIG_MPLS=y
CONFIG_NET_MPLS_GSO=m
CONFIG_MPLS_ROUTING=m
CONFIG_MPLS_IPTUNNEL=m

#
# Transports and sockets
#
CONFIG_MPTCP=y
CONFIG_MPTCP_IPV6=y
CONFIG_INET_MPTCP_DIAG=m
CONFIG_MPTCP_KUNIT_TEST=m
CONFIG_AF_KCM=m
CONFIG_RDS=m
CONFIG_RDS_RDMA=m
CONFIG_RDS_TCP=m
CONFIG_TIPC=m
CONFIG_TIPC_MEDIA_IB=y
CONFIG_TIPC_MEDIA_UDP=y
CONFIG_TIPC_CRYPTO=y
CONFIG_TIPC_DIAG=m
CONFIG_AF_RXRPC=m
CONFIG_AF_RXRPC_IPV6=y
CONFIG_RXKAD=y
CONFIG_RXGK=y
CONFIG_RXPERF=m
CONFIG_AF_RXRPC_KUNIT_TEST=m
CONFIG_HYPERV_VSOCKETS=m
CONFIG_VMWARE_VMCI_VSOCKETS=m

#
# Device and management protocols
#
CONFIG_MCTP=y
CONFIG_MCTP_TEST=y
CONFIG_NET_NCSI=y
CONFIG_NCSI_OEM_CMD_GET_MAC=y
CONFIG_NCSI_OEM_CMD_KEEP_PHY=y
CONFIG_NFC=m
CONFIG_NFC_DIGITAL=m
CONFIG_NFC_NCI=m
CONFIG_NFC_NCI_SPI=m
CONFIG_NFC_NCI_UART=m
CONFIG_NFC_HCI=m
CONFIG_NFC_SHDLC=y
CONFIG_PHONET=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_TUN=m
CONFIG_QRTR_MHI=m
