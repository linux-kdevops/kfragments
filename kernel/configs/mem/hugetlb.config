# Help: HugeTLB pages with their cgroup controller and CMA pool
#
# HUGETLBFS, =y in core/core.config, with what the rest of the HugeTLB
# code builds under: the hugetlb cgroup controller (CGROUP_HUGETLB)
# and gigantic pages reserved from CMA at boot (hugetlb_cma). The
# vmemmap optimization follows HUGETLB_PAGE where the architecture
# has it.
#
# Every symbol is bool. No builtin/ counterpart needed.
# See: fs/Kconfig
# See: https://docs.kernel.org/admin-guide/mm/hugetlbpage.html
CONFIG_HUGETLBFS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CMA=y
