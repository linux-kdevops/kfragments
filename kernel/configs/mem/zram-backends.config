# Help: Every ZRAM compression backend
#
# Layered on mem/zram.config, which leaves ZRAM on LZO alone: this
# adds the LZ4, LZ4HC, Zstandard, deflate and 842 backends, with which
# Kconfig no longer forces LZO. LZO stays on and lzo-rle the default.
# ZRAM is inlined from mem/zram.config, which has no builtin/
# counterpart, so neither has this.
# See: drivers/block/zram/Kconfig
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_842=y
CONFIG_ZRAM_BACKEND_FORCE_LZO=n
CONFIG_ZRAM_BACKEND_LZO=y
