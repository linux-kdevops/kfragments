# Help: userfaultfd
#
# The userfaultfd() system call and /dev/userfaultfd, by which a
# process handles its own page faults, as QEMU's postcopy live
# migration does. USERFAULTFD defaults to n.
#
# Every symbol is bool. No builtin/ counterpart needed.
# See: mm/Kconfig
# See: https://docs.kernel.org/admin-guide/mm/userfaultfd.html
CONFIG_USERFAULTFD=y
