# Help: Swap
#
# SWAP defaults to y, which an allnoconfig-based merge drops; without
# it the kernel neither swaps nor builds the swapfile code of the
# filesystems that host one (fs/iomap/swapfile.c). mem/zram.config
# sets it too.
#
# Every symbol is bool. No builtin/ counterpart needed.
# See: mm/Kconfig
CONFIG_SWAP=y
