# Help: the kernel crate's modules for drivers outside the base
#
# rust/kernel/lib.rs builds each of these modules only when its #[cfg]
# holds: cpufreq under CPU_FREQ, opp under PM_OPP, which PM_DEVFREQ
# selects, firmware under RUST_FW_LOADER_ABSTRACTIONS, fwctl under
# RUST_FWCTL_ABSTRACTIONS, which needs FWCTL=y, serdev under
# RUST_SERIAL_DEV_BUS_ABSTRACTIONS, usb under USB=y, and gpu under
# GPU_BUDDY=y, which NOVA_CORE selects, and net's phy under
# RUST_PHYLIB_ABSTRACTIONS, which needs PHYLIB=y.
#
# Left out: pwm, whose abstractions only the T-Head PWM_TH1520 driver
# selects; soc, whose SOC_BUS only Arm platforms and
# rust/rust-samples-all.config select; and drm's gpuvm, which only Tyr,
# an Arm driver, selects.
#
# Self-contained: inlines rust.config's RUST and the RANDSTRUCT_NONE it
# requires.
# See: rust/kernel/lib.rs
CONFIG_RANDSTRUCT_NONE=y
CONFIG_RUST=y
CONFIG_CPU_FREQ=y
CONFIG_PM_DEVFREQ=y
CONFIG_RUST_FW_LOADER_ABSTRACTIONS=y
CONFIG_FWCTL=y
CONFIG_RUST_FWCTL_ABSTRACTIONS=y
CONFIG_RUST_SERIAL_DEV_BUS_ABSTRACTIONS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_NOVA_CORE=m
CONFIG_PHYLIB=y
CONFIG_RUST_PHYLIB_ABSTRACTIONS=y
