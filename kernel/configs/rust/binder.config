# Help: Android Binder IPC, the Rust driver
#
# ANDROID_BINDER_IPC_RUST is a bool, so there is no builtin/ counterpart.
# Self-contained: inlines rust.config's RUST and the RANDSTRUCT_NONE it
# requires; the NET it depends on is in the base.
# See: drivers/android/Kconfig
CONFIG_RANDSTRUCT_NONE=y
CONFIG_RUST=y
CONFIG_ANDROID_BINDER_IPC_RUST=y
