# Help: Rust language support
#
# Enables Rust in the kernel. Requires RANDSTRUCT disabled. JUMP_LABEL
# gives the kernel crate its static branches
# (generated_arch_static_branch_asm.rs), as it gives C its static keys.
# For module versioning with Rust, also apply modversions.config
# and gendwarfksyms.config.
# See: https://docs.kernel.org/rust/
CONFIG_RANDSTRUCT_NONE=y
CONFIG_RUST=y
CONFIG_JUMP_LABEL=y
