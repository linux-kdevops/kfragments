# Help: Rust kernel crate doctests as a KUnit suite
#
# Runs the kernel crate's documentation examples as the KUnit suite
# rust_doctests_kernel. Inlines rust.config's RUST (and the
# RANDSTRUCT_NONE it requires) and KUNIT=y, which RUST_KERNEL_DOCTESTS
# depends on. KUNIT_DEFAULT_ENABLED defaults to y, but allnoconfig
# drops it and KUnit then runs no suite (kunit.enable=0). When the
# suite runs, on demand or at boot, is test/kunit.config's and
# test/kunit-autorun.config's choice.
# See: https://docs.kernel.org/rust/testing.html
CONFIG_RANDSTRUCT_NONE=y
CONFIG_RUST=y
CONFIG_KUNIT=y
CONFIG_KUNIT_DEFAULT_ENABLED=y
CONFIG_RUST_KERNEL_DOCTESTS=y
