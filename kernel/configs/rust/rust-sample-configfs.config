# Help: The Rust configfs sample
#
# samples/rust/rust_configfs.rs, the user of the kernel crate's configfs
# module, alone; rust/rust-samples-all.config builds it with the rest.
#
# Prerequisites inlined per the self-containment rule: rust.config's
# RUST and the RANDSTRUCT_NONE it requires, and CONFIGFS_FS.
#
# Layer builtin/rust/rust-sample-configfs.config to build it in (=y).
# See: samples/rust/Kconfig
CONFIG_RANDSTRUCT_NONE=y
CONFIG_RUST=y
CONFIG_CONFIGFS_FS=m
CONFIG_SAMPLES=y
CONFIG_SAMPLES_RUST=y
CONFIG_SAMPLE_RUST_CONFIGFS=m
