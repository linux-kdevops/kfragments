# Help: Every Rust kernel sample, with the host programs
#
# All of samples/rust: the minimal module, printing and its tracepoint,
# the misc device, configfs, DMA, debugfs, the PCI, platform, USB, I2C,
# faux, auxiliary and serdev drivers, the SoC device and the host
# programs. rust/rust-samples.config builds the minimal one alone.
#
# Prerequisites inlined per the self-containment rule:
# - rust.config's RUST and the RANDSTRUCT_NONE it requires.
# - CONFIGFS_FS, PCI and DEBUG_FS for the samples of each.
# - I2C=y and USB=y, as the I2C and USB samples ask for a built-in bus.
#
# Layer builtin/rust/rust-samples-all.config to build them in (=y).
# See: samples/rust/Kconfig

#
# Inlined prerequisites
#
CONFIG_RANDSTRUCT_NONE=y
CONFIG_RUST=y
CONFIG_CONFIGFS_FS=m
CONFIG_PCI=y
CONFIG_DEBUG_FS=y
CONFIG_I2C=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y

#
# Samples
#
CONFIG_SAMPLES=y
CONFIG_SAMPLES_RUST=y
CONFIG_SAMPLE_RUST_CONFIGFS=m
CONFIG_SAMPLE_RUST_MINIMAL=m
CONFIG_SAMPLE_RUST_MISC_DEVICE=m
CONFIG_SAMPLE_RUST_PRINT=m
CONFIG_SAMPLE_RUST_DMA=m
CONFIG_SAMPLE_RUST_DEBUGFS=m
CONFIG_SAMPLE_RUST_DEBUGFS_SCOPED=m
CONFIG_SAMPLE_RUST_DRIVER_I2C=m
CONFIG_SAMPLE_RUST_I2C_CLIENT=m
CONFIG_SAMPLE_RUST_DRIVER_PCI=m
CONFIG_SAMPLE_RUST_DRIVER_PLATFORM=m
CONFIG_SAMPLE_RUST_DRIVER_USB=m
CONFIG_SAMPLE_RUST_DRIVER_FAUX=m
CONFIG_SAMPLE_RUST_DRIVER_AUXILIARY=m
CONFIG_SAMPLE_RUST_DRIVER_SERDEV=m
CONFIG_SAMPLE_RUST_SOC=m
CONFIG_SAMPLE_RUST_HOSTPROGS=y
