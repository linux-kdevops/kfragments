# Help: Xen guest and dom0 support, with the Xen block frontend and backend
#
# The kernel as a Xen PV and PVH guest, and as dom0, whose backend
# drivers serve other guests' disks: xen-blkfront and xen-blkback. On
# x86_64 Xen sits on paravirtualization under HYPERVISOR_GUEST and
# dom0 takes PV or PVH; on arm64 XEN alone brings dom0, and the x86
# symbols below are not defined. Nothing here runs under QEMU without
# Xen: it builds the drivers.
#
# Layer builtin/virt/xen.config to build the block drivers in (=y).
# See: arch/x86/xen/Kconfig
# See: drivers/xen/Kconfig
# See: drivers/block/Kconfig

#
# Inlined prerequisites (x86_64)
#
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y

#
# Xen guest and dom0
#
CONFIG_XEN=y
CONFIG_XEN_PV=y
CONFIG_XEN_PVH=y
CONFIG_XEN_DOM0=y
CONFIG_XEN_BACKEND=y

#
# Block frontend and backend
#
CONFIG_XEN_BLKDEV_FRONTEND=m
CONFIG_XEN_BLKDEV_BACKEND=m
