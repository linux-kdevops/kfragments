# Help: KVM RISC-V's optional parts: PMU and SBI v0.1 emulation
#
# Layered on virt/kvm-riscv.config: the guest PMU over the SBI PMU
# extension and the legacy SBI v0.1 calls. RISCV_PMU and RISCV_PMU_SBI
# default to y, which an allnoconfig-based merge drops. KVM is inlined
# from virt/kvm-riscv.config.
#
# builtin/virt/kvm-riscv.config builds KVM in; every other symbol here
# is bool.
# See: arch/riscv/kvm/Makefile
# See: drivers/perf/Kconfig
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_PERF_EVENTS=y
CONFIG_RISCV_PMU=y
CONFIG_RISCV_PMU_SBI=y
CONFIG_RISCV_SBI_V01=y
